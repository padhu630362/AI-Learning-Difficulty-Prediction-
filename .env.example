# AI Learning Difficulty Predictor Configuration
FLASK_ENV=development
SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-32-byte-secret-key-for-jwt-signing-2026
JWT_EXPIRATION_HOURS=24

# Database
# For SQLite (default local development):
# Leave DATABASE_URL empty or use: sqlite:///backend/data/app.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/learning_predictor_db

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Port
PORT=5000

